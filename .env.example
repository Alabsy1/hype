# Hype — environment variable reference (placeholders only).
# Copy to `.env` and fill with real values. NEVER commit `.env*` files.

# Runtime connection for the Prisma client (driver adapter).
# On Neon use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&pgbouncer=true"

# Direct connection used by Prisma CLI (migrations / studio / db commands).
# On Neon use the direct (non-pooled) connection string.
# The Prisma CLI reads DIRECT_URL first, falling back to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# --- Phase 06 authentication ---
# No auth secrets are required in this phase. Session lifetime (7 days) and
# the session cookie name ("hype_session") are constants in
# src/lib/server/auth/constants.ts. See docs/AUTHENTICATION.md.
# A future admin-bootstrap command (not implemented yet) will read
# ADMIN_EMAIL / ADMIN_PASSWORD from the environment — never commit real values.